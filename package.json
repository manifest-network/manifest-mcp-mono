{
  "name": "manifest-mcp-mono",
  "version": "0.21.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "depcruise": "depcruise packages examples --config .dependency-cruiser.cjs",
    "check": "biome check packages/ examples/",
    "check:fix": "biome check --write packages/ examples/",
    "format": "biome format --write packages/ examples/",
    "test": "npm run test --workspaces --if-present",
    "check:packages": "node scripts/check-packages.mjs",
    "pretest:e2e": "npm run build -w @manifest-network/sdk-acceptance",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "size": "size-limit",
    "release:version": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@size-limit/preset-small-lib": "13.0.3",
    "dependency-cruiser": "18.2.0",
    "size-limit": "13.0.3",
    "tsdown": "0.22.14",
    "vitest": "4.1.10",
    "publint": "0.3.24",
    "@arethetypeswrong/core": "0.18.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "ipaddr.js": "2.4.0",
    "@cosmjs/stargate": "npm:@manifest-network/stargate@0.32.4-ll.3",
    "axios": "1.19.0",
    "protobufjs": "7.6.5"
  }
}
