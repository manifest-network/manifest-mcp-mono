node_modules/
dist/
*.tsbuildinfo

# Build artifacts that may land in src/ (tsdown emits to dist/ but tsc --build can leak)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Known-bad probes written into real sources by the depcruise positive controls
# (packages/sdk/scripts/cast-guard.test.ts). Removed in a `finally`, but a killed run leaves one
# behind and it must never be committable.
packages/*/src/__dcprobe_*.ts
examples/*/src/__dcprobe_*.ts
# Same shape for the root type-test harness's probes (scripts/check-type-tests.test.mjs).
packages/*/src/__tcprobe_*.ts
packages/*/src/.__tcprobe_*/
.claude/worktrees/__tcprobe_*/
.env
!e2e/.env
.env.local
.mcp.json

# E2E artifacts
e2e-logs.txt
e2e/.tls/
